PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripnexus
JWT_SECRET=change-me
JWT_EXPIRY=7d
# Environment Variables
DATABASE_URL=postgresql://user:password@localhost:5432/tripnexus
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# Server
PORT=5000
NODE_ENV=development

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# WhatsApp (Optional)
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_ID=your-phone-id

# Meta Facebook/Instagram Lead Ads webhook (optional)
META_WEBHOOK_VERIFY_TOKEN=choose-a-long-random-value
META_APP_SECRET=your-meta-app-secret
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
META_PAGE_ID=your-meta-page-id
META_DEFAULT_AGENT_ID=crm-agent-user-uuid
META_GRAPH_API_VERSION=v24.0
